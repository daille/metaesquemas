{
  "name": "metaesquemas-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Worker de ingesta y compilación TypeSpec (AOT): genera OpenAPI, JSON Schema, XSD y Protobuf al cargar cada archivo.",
  "scripts": { "start": "node src/main.js", "test": "node --test test/*.test.js" },
  "dependencies": {
    "@catalogo/typespec": "file:./packages/catalogo",
