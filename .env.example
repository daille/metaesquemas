# Copiar a .env (NO versionar). Generar secretos con:  openssl rand -hex 32
CORS_ALLOWED_ORIGINS=https://catalogo.example
WEB_PORT=8080

# Token para cargar esquemas (POST /api/v1/admin/schemas). Vacío = ingesta deshabilitada.
ADMIN_TOKEN=
# Claves de integradores con cupo ampliado (separadas por coma)
API_KEYS=

# Rate limiting (solicitudes/seg y ráfaga por IP, o por API key)
RATE_ANON_RPS=20
RATE_ANON_BURST=60
RATE_KEY_RPS=100
RATE_KEY_BURST=300
RATE_ADMIN_RPS=0.5
RATE_ADMIN_BURST=5

# Geobloqueo: deny = bloquear la lista; allow = permitir solo la lista
# Ruta de la base MaxMind dentro del contenedor (copiar el .mmdb a deploy/geoip/ y usar /geo/GeoLite2-Country.mmdb). Vacío = sin GeoIP
GEOIP_DB=
GEO_MODE=deny
GEO_COUNTRIES=RU,KP
GEO_DENY_CIDRS=
GEO_FAIL_CLOSED=false
# Si hay un CDN delante (Cloudflare: CF-IPCountry) se usa su cabecera solo desde proxies de confianza
GEO_COUNTRY_HEADER=

HSTS=true
MAX_UPLOAD_BYTES=262144
# Límites de compilación del worker
COMPILE_TIMEOUT_MS=60000
COMPILE_MEMORY_MB=768
